  function editUserAllowed(uid){return admin() && (uid==request.auth.uid || primaryAdmin() || canBlockUser(uid));}
  // Only the existing restricted server identity completes an admin's deletion
  // lock after server-side history checks. Browser clients cannot delete users.
  function userDeletionService(uid){
   let p=/databases/$(database)/documents/userAccess/$(uid);let before=get(p).data;let after=getAfter(p).data;
   return paymentBot() && validUid(uid) && uid!='PRIMARY_ADMIN_UID_HERE'
    && (!existsAfter(/databases/$(database)/documents/admins/$(uid)) || getAfter(/databases/$(database)/documents/admins/$(uid)).data.enabled!=true)
