rules_version = '2';
// merchantTeamUsers/{businessId}~{uid}: businessId/uid immutable, sourceStoreId,
// email<=254 (verified directory or empty), role enum, enabled bool, createdAt immutable,
// updatedAt/request.time, updatedBy/current UID. Explicit grant overrides legacy scope.
// merchantEmailDirectory/{email hash}: uid immutable, verified normalized email, updatedAt.
// Exact get only; owners/admins resolve approved identities, never list the directory.
// merchantEmailLookups/{actorUid}: exact emailHash/sourceStoreId, createdAt=request.time;
// owner/admin-only intent authorizes that one hash for at most two minutes.
// Prototype rules tested against the app's Web SDK queries and attack cases.
// days/{id}: date immutable, label100, status enum, cutoffAt timestamp,
// optional closedAt timestamp (first close immutable), dispatchId hex32 (each close),
// menuCount1..60, updatedAt. dishes/{hash}: name160, price int, active bool,
// updatedAt. orders/{hash}: ownerId128/name100 (immutable except controlled
// owner transfer), dishId64hex/dish160, price int, quantity1..30, note300,
// paid/cancelled bool, immutable createdAt, updatedAt; timestamps use request.time.
// admins/{uid}: enabled=true, Console bootstrap then primary-admin management. accountLinks/{sourceUid}:
// targetUid, createdAt, expiresAt<=10min. settings/payment: qrUrl, updatedAt.
// pickupDraws/{YYYY-MM-DD}: date/weekStart/dayId, count1..10, candidateCount<=500,
// selectedKeys (unique), selectedNames and previousCounts (parallel lists<=10;
// key/name strings1..100, previousCount0..6),
// createdBy128, createdAt=request.time, version=1. Admin create only; immutable.
// userProfiles/{uid}: displayName/preferredName0..100, email0..254 matching
// verified token, provider anonymous/google.com, immutable createdAt, lastSeenAt.
// Private to owner and admins. userAccess/{uid}: blocked bool, updatedBy128,
// updatedAt. admins new writes: enabled bool, updatedBy128, updatedAt.
// Primary admin alone changes other roles; no self/primary lockout or deletes.
// Every other collection, including the legacy server schema, stays denied.
// settings/payment bank schema: bankBin6, bankName100, accountNumber alnum34,
// accountName70, updatedAt. Immutable paymentIntents bind an exact order/payee
// snapshot to COM+20hex, an owner/admin requester and expiry<=24h. paymentLinks
// select the current intent atomically. Primary-only paymentIntegrations grant
// a dedicated anonymous bot; no administrator role is granted to that identity.
// Immutable paymentReceipts and paymentTransactions pair one reference with
// one bank/account/transaction hash. Bot writes only paid=true + updatedAt,
// atomically with both records, using the unchanged current order/payee/link.
// companies/departments: admin-managed names<=100, active, immutable createdAt,
// updatedAt/request.time and updatedBy/UID; department companyId immutable.
// Optional deletionToken32hex + deletionStartedAt/request.time lock new links.
// Catalog deletion is admin-only, requires a lock and cleared default; the
// trusted admin client must server-query all personalDetails before deleting.
// settings/organization: active default company/department pair, admin write.
// personalDetails/{uid}: phone<=30, jobTitle<=100, valid company/department IDs;
// owner write, owner/admin read. Does not change roles or order ownership.
// personalImports/{uid~hash}: immutable bounded upload manifest; owner upload/
// restore metadata, admin review acknowledgment only. chunks/{index}: private,
// immutable strings<=150000; <=70 chunks, entire UTF-8 JSON<=10MB. Uploaded
// financial values are untrusted archive data and never authorize money writes.
// personalExports/{32hex}: server integration creates immutable SHA256 receipts
// for API-generated v2 files; owner/admin/service get only, no list or edits.
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  // Membership reserves an account for Merchant, even while disabled.
  // Only verified Google admins may enter both customer and merchant portals.
  function customerAccount(){return signedIn() && (!exists(/databases/$(database)/documents/merchantUsers/$(request.auth.uid)) || admin());}
  function googleUser(){return signedIn() && request.auth.token.get('email_verified',false) == true && request.auth.token.firebase.sign_in_provider == 'google.com';}
  function admin(){return googleUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;}
  function primaryAdmin(){return admin() && request.auth.uid == 'PRIMARY_ADMIN_UID_HERE';}
  function validUid(uid){return uid is string && uid.matches('^[A-Za-z0-9_-]{1,128}$');}
  function activeUser(){return !exists(/databases/$(database)/documents/userAccess/$(request.auth.uid)) || get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data.blocked == false;}
  function validText(value,max){return value is string && value.size()>0 && value.size()<=max && value == value.trim();}
  // Match the browser's name IDs for Vietnamese names beginning with Đ.
  function hash(value){return hashing.sha256(value.lower().replace('Đ','đ')).toHexString().lower();}
  function openDay(dayId){
   let day=get(/databases/$(database)/documents/days/$(dayId)).data;
   return day.get('changing',false)==false && (day.status == 'open' || (day.status == 'auto' && request.time < day.cutoffAt));
  }
  function validDay(d){
   return d.keys().hasAll(['date','label','status','cutoffAt','menuCount','updatedAt']) && d.keys().hasOnly(['date','label','status','cutoffAt','menuCount','updatedAt','closedAt','dispatchId','changing','changeId'])
    && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && validText(d.label,100) && d.status in ['auto','open','closed']
    && d.menuCount is int && d.menuCount>=1 && d.menuCount<=60
    && d.cutoffAt is timestamp && d.cutoffAt == timestamp.date(int(d.date.split('-')[0]),int(d.date.split('-')[1]),int(d.date.split('-')[2])) + duration.value(150,'m')
    && d.updatedAt == request.time && validClosureFields(d) && ((!('changing' in d) && !('changeId' in d)) || (d.changing is bool && d.changeId is string && d.changeId.matches('^[a-f0-9]{32}$')));
  }
  // First close is immutable; redispatch cannot extend the reopening deadline.
  function validClosureFields(d){return (!('closedAt' in d) && !('dispatchId' in d) && d.status!='closed') || (d.closedAt is timestamp && d.closedAt<=request.time && d.dispatchId is string && d.dispatchId.matches('^[a-f0-9]{32}$'));}
  function newClosure(d){return d.status=='closed'?d.closedAt==request.time:!('closedAt' in d);}
  function closureChange(a,b){
   let anchor=a.get('closedAt',a.cutoffAt);
   let closing=b.status=='closed' && (a.status!='closed' || !('dispatchId' in a));
   return (a.status!='closed' || b.status=='closed' || request.time<=anchor+duration.value(15,'m'))
    && (('closedAt' in a)?b.get('closedAt',null)==a.closedAt:(b.status=='closed'?b.closedAt==(a.status=='closed'?a.cutoffAt:request.time):!('closedAt' in b)))
    && (closing?b.dispatchId!=a.get('dispatchId',''):b.get('dispatchId','')==a.get('dispatchId',''));
  }
  function releasedDay(dayId){let d=get(/databases/$(database)/documents/days/$(dayId));return d!=null && d.data.get('changing',false)==false && d.data.status=='closed' && d.data.get('closedAt',null) is timestamp && d.data.get('dispatchId','').matches('^[a-f0-9]{32}$');}
  function validDish(d,dishId){
   return d.keys().hasAll(['name','price','active','updatedAt']) && d.keys().hasOnly(['name','price','active','updatedAt']) && validText(d.name,160) && dishId == hash(d.name)
    && d.price is int && d.price>=1000 && d.price<=1000000 && d.active is bool && d.updatedAt == request.time;
  }
  function validOrder(d,orderId){
   return d.keys().hasAll(['name','ownerId','dishId','dish','price','quantity','note','paid','cancelled','createdAt','updatedAt'])
    && d.keys().hasOnly(['name','ownerId','dishId','dish','price','quantity','note','paid','cancelled','createdAt','updatedAt','receivedAmount','refundedAmount','voidedAmount','paymentEventId','creditInAmount','creditOutAmount','surplusChoice','lastCreditTransferId']) && validMoney(d)
    && validText(d.name,100) && orderId.matches('^'+hash(d.name)+'(_([1-9]|[12][0-9]|30))?$') && d.ownerId is string && d.ownerId.size()>0 && d.ownerId.size()<=128
    && d.dishId is string && d.dishId.matches('^[a-f0-9]{64}$') && validText(d.dish,160) && d.price is int && d.price>=1000 && d.price<=1000000
    && d.quantity is int && d.quantity>=1 && d.quantity<=30 && d.note is string && d.note.size()<=300 && d.paid is bool && d.cancelled is bool
    && d.createdAt is timestamp && d.updatedAt == request.time;
  }
  function received(d){return 'receivedAmount' in d?d.receivedAmount:(d.paid?d.price*d.quantity:0);}
  function refunded(d){return d.get('refundedAmount',0);}
  function voided(d){return d.get('voidedAmount',0);}
  function creditIn(d){return d.get('creditInAmount',0);}
  function creditOut(d){return d.get('creditOutAmount',0);}
  function choice(d){return d.get('surplusChoice','refund');}
  function held(d){return received(d)+creditIn(d)-creditOut(d)-refunded(d)-voided(d);}
  function owed(d){return d.cancelled?0:d.price*d.quantity;}
  function due(d){let total=owed(d);let balance=held(d);return total>balance?total-balance:0;}
  function refundDue(d){let total=owed(d);let balance=held(d);return balance>total?balance-total:0;}
  function validMoney(d){let r=received(d);let f=d.get('refundedAmount',0);let v=d.get('voidedAmount',0);let ci=d.get('creditInAmount',0);let co=d.get('creditOutAmount',0);let c=d.get('surplusChoice','refund');let e=d.get('paymentEventId','');let last=d.get('lastCreditTransferId','');return r is int && r>=0 && r<=1000000000 && f is int && f>=0 && v is int && v>=0 && ci is int && ci>=0 && ci<=1000000000 && co is int && co>=0 && co<=1000000000 && r+ci-co-f-v>=0 && c in ['refund','carry'] && last is string && last.size()<=32 && e is string && e.size()<=32;}
  function derivedPaid(d){return d.paid==(!d.cancelled && held(d)>=d.price*d.quantity);}
  function moneyUnchanged(a,b){return received(a)==received(b) && refunded(a)==refunded(b) && voided(a)==voided(b) && creditIn(a)==creditIn(b) && creditOut(a)==creditOut(b) && choice(a)==choice(b);}
  // Inline identical default-value getters to stay under Rules expression limits
  // when grouped settlements also enforce portal admission. No predicate changes.
  function bankMoney(d,amount){let old=resource.data;return received(d)==received(old)+amount && d.get('refundedAmount',0)==old.get('refundedAmount',0) && d.get('voidedAmount',0)==old.get('voidedAmount',0) && d.get('creditInAmount',0)==old.get('creditInAmount',0) && d.get('creditOutAmount',0)==old.get('creditOutAmount',0) && d.get('surplusChoice','refund')==old.get('surplusChoice','refund') && derivedPaid(d); }
  function financialEvent(dayId,orderId,d){
   let id=d.get('paymentEventId','');
   let path=/databases/$(database)/documents/days/$(dayId)/orders/$(orderId)/financialEvents/$(id);
   let e=getAfter(path).data;
   let old=resource.data;
   let values=[received(old),old.get('refundedAmount',0),old.get('voidedAmount',0),old.get('creditInAmount',0),old.get('creditOutAmount',0),old.get('surplusChoice','refund')];
   let amount=(old.cancelled?0:old.price*old.quantity)-values[0]+values[1]+values[2]-values[3]+values[4];
   return id.matches('^[a-f0-9]{32}$') && !exists(path) && e.createdAt==request.time && e.createdBy==request.auth.uid
    && e.beforeReceived==values[0] && e.beforeRefunded==values[1] && e.beforeVoided==values[2]
    && e.afterReceived==d.receivedAmount && e.afterRefunded==d.refundedAmount && e.afterVoided==d.voidedAmount
    && d.creditInAmount==values[3] && d.creditOutAmount==values[4] && d.surplusChoice==values[5] && derivedPaid(d) && d.diff(old).affectedKeys().hasOnly(['paid','receivedAmount','refundedAmount','voidedAmount','creditInAmount','creditOutAmount','surplusChoice','paymentEventId','updatedAt'])
    && ((e.kind=='receive' && !old.cancelled && amount>0 && d.receivedAmount==values[0]+amount && d.refundedAmount==values[1] && d.voidedAmount==values[2])
     || (e.kind=='void' && values[3]==0 && !old.cancelled && values[0]-values[1]-values[2]-values[4]>0 && d.voidedAmount==values[0]-values[1]-values[4] && d.receivedAmount==values[0] && d.refundedAmount==values[1])
     || (e.kind=='refund' && values[5]=='refund' && amount<0 && d.refundedAmount==values[1]-amount && d.receivedAmount==values[0] && d.voidedAmount==values[2]));
  }
  match /days/{dayId}/orders/{orderId}/financialEvents/{eventId}{
   allow read: if customerAccount() && (admin() || get(/databases/$(database)/documents/days/$(dayId)/orders/$(orderId)).data.ownerId==request.auth.uid);
   allow create: if admin() && eventId.matches('^[a-f0-9]{32}$') && request.resource.data.keys().hasAll(['kind','createdBy','createdAt','beforeReceived','beforeRefunded','beforeVoided','afterReceived','afterRefunded','afterVoided']) && request.resource.data.keys().hasOnly(['kind','createdBy','createdAt','beforeReceived','beforeRefunded','beforeVoided','afterReceived','afterRefunded','afterVoided']) && request.resource.data.createdAt==request.time && request.resource.data.createdBy==request.auth.uid && getAfter(/databases/$(database)/documents/days/$(dayId)/orders/$(orderId)).data.paymentEventId==eventId && getAfter(/databases/$(database)/documents/days/$(dayId)/orders/$(orderId)).data.updatedAt==request.time;
   allow update,delete: if false;
  }
  function menuPrice(dayId,d){
   let item=get(/databases/$(database)/documents/days/$(dayId)/dishes/$(d.dishId)).data;
   return item.active == true && d.dish == item.name && d.price == item.price;
  }
  function samePrice(d){return d.dishId == resource.data.dishId && d.dish == resource.data.dish && d.price == resource.data.price;}
  function recipient(sourceUid){
   let path=/databases/$(database)/documents/accountLinks/$(sourceUid);
   return customerAccount() && googleUser() && exists(path) && get(path).data.targetUid == request.auth.uid && request.time < get(path).data.expiresAt;
  }
  function ownOrder(){return customerAccount() && resource.data.ownerId == request.auth.uid;}
  function parentExists(dayId){return exists(/databases/$(database)/documents/days/$(dayId));}
  function correctPayment(d){return moneyUnchanged(d,resource.data) && derivedPaid(d);}
  function creditPointerMove(dayId,orderId){let p=/databases/$(database)/documents/creditSources/$(dayId+'~'+orderId);return !exists(p) || getAfter(p).data.ownerId==request.auth.uid;}
  function surplusChange(dayId,orderId,d){
   return refundDue(resource.data)>0 && received(d)==received(resource.data) && refunded(d)==refunded(resource.data) && voided(d)==voided(resource.data) && creditIn(d)==creditIn(resource.data) && creditOut(d)==creditOut(resource.data) && d.paid==resource.data.paid
    && d.diff(resource.data).affectedKeys().hasOnly(['surplusChoice','receivedAmount','refundedAmount','voidedAmount','creditInAmount','creditOutAmount','updatedAt'])
    && (choice(d)=='refund' || getAfter(/databases/$(database)/documents/creditSources/$(dayId+'~'+orderId)).data.ownerId==resource.data.ownerId);
  }
  function linkedCreditTransfer(dayId,orderId,d){
   let id=d.get('lastCreditTransferId','');let p=/databases/$(database)/documents/creditTransfers/$(id);let e=getAfter(p).data;
   return id.matches('^[a-f0-9]{32}$') && id!=resource.data.get('lastCreditTransferId','') && !exists(p) && e.createdAt==request.time && e.createdBy==request.auth.uid
    && ((e.sourceDayId==dayId && e.sourceOrderId==orderId)||(e.targetDayId==dayId && e.targetOrderId==orderId));
  }
  function validCreditSource(d,key){return d.keys().hasAll(['dayId','orderId','ownerId','createdAt','updatedAt']) && d.keys().hasOnly(['dayId','orderId','ownerId','createdAt','updatedAt']) && validUid(d.ownerId) && key==d.dayId+'~'+d.orderId && d.dayId is string && d.dayId.matches('^[A-Za-z0-9_-]{1,100}$') && d.orderId is string && d.orderId.matches('^[a-f0-9]{64}(_([1-9]|[12][0-9]|30))?$') && d.createdAt is timestamp && d.updatedAt==request.time;}
  match /creditSources/{key}{
   allow read: if customerAccount();
   allow create: if customerAccount() && validCreditSource(request.resource.data,key) && request.resource.data.createdAt==request.time && (request.resource.data.ownerId==request.auth.uid || admin()) && getAfter(/databases/$(database)/documents/days/$(request.resource.data.dayId)/orders/$(request.resource.data.orderId)).data.ownerId==request.resource.data.ownerId && choice(getAfter(/databases/$(database)/documents/days/$(request.resource.data.dayId)/orders/$(request.resource.data.orderId)).data)=='carry';
   allow update: if customerAccount() && validCreditSource(request.resource.data,key) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId','updatedAt']) && recipient(resource.data.ownerId) && request.resource.data.ownerId==request.auth.uid && getAfter(/databases/$(database)/documents/days/$(resource.data.dayId)/orders/$(resource.data.orderId)).data.ownerId==request.auth.uid;
   allow delete: if false;
  }
  function validCreditTransfer(e,id){
   let sp=/databases/$(database)/documents/days/$(e.sourceDayId)/orders/$(e.sourceOrderId);let tp=/databases/$(database)/documents/days/$(e.targetDayId)/orders/$(e.targetOrderId);
   let a=get(sp).data;let b=get(tp).data;let na=getAfter(sp).data;let nb=getAfter(tp).data;
   let va=[received(a),a.get('refundedAmount',0),a.get('voidedAmount',0),a.get('creditInAmount',0),a.get('creditOutAmount',0),a.get('surplusChoice','refund')];
   let vb=[received(b),b.get('refundedAmount',0),b.get('voidedAmount',0),b.get('creditInAmount',0),b.get('creditOutAmount',0),b.get('surplusChoice','refund')];
   let ah=va[0]-va[1]-va[2]+va[3]-va[4];let bh=vb[0]-vb[1]-vb[2]+vb[3]-vb[4];
   return id.matches('^[a-f0-9]{32}$') && e.keys().hasAll(['ownerId','sourceDayId','sourceOrderId','targetDayId','targetOrderId','amount','createdBy','createdAt']) && e.keys().hasOnly(['ownerId','sourceDayId','sourceOrderId','targetDayId','targetOrderId','amount','createdBy','createdAt'])
    && sp!=tp && e.ownerId==a.ownerId && a.ownerId==b.ownerId && (a.ownerId==request.auth.uid || admin()) && e.createdBy==request.auth.uid && e.createdAt==request.time && e.amount is int && e.amount>0 && e.amount<=30000000
    && va[5]=='carry' && ah-(a.cancelled?0:a.price*a.quantity)>=e.amount && !b.cancelled && b.price*b.quantity-bh>=e.amount
    && na.lastCreditTransferId==id && nb.lastCreditTransferId==id && na.updatedAt==request.time && nb.updatedAt==request.time
    && na.diff(a).affectedKeys().hasOnly(['creditOutAmount','creditInAmount','surplusChoice','receivedAmount','refundedAmount','voidedAmount','lastCreditTransferId','paid','updatedAt']) && nb.diff(b).affectedKeys().hasOnly(['creditOutAmount','creditInAmount','surplusChoice','receivedAmount','refundedAmount','voidedAmount','lastCreditTransferId','paid','updatedAt'])
    && na.creditOutAmount==va[4]+e.amount && na.creditInAmount==va[3] && na.receivedAmount==va[0] && na.refundedAmount==va[1] && na.voidedAmount==va[2] && na.surplusChoice==va[5]
    && nb.creditInAmount==vb[3]+e.amount && nb.creditOutAmount==vb[4] && nb.receivedAmount==vb[0] && nb.refundedAmount==vb[1] && nb.voidedAmount==vb[2] && nb.surplusChoice==vb[5] && na.paid==(!a.cancelled && ah-e.amount>=a.price*a.quantity) && nb.paid==(bh+e.amount>=b.price*b.quantity);
  }
  match /creditTransfers/{id}{allow read: if customerAccount();allow create: if customerAccount() && validCreditTransfer(request.resource.data,id);allow update,delete: if false;}
  function validActivity(d){return d.keys().hasAll(['kind','actorId','source','summary','dayId','orderId','reference','details','createdAt']) && d.keys().hasOnly(['kind','actorId','source','summary','dayId','orderId','reference','details','createdAt']) && d.actorId==request.auth.uid && d.createdAt==request.time && d.source in ['app','bank'] && d.kind in ['app.visit','page.view','auth.signin','auth.signout','order.create','order.update','order.cancel','order.transfer','menu.save','payment.receive','payment.void','payment.refund','payment.qr','bank.received','bank.notice','app.error','payment.settings','credit.choice','credit.apply','user.block','user.role','user.update','user.delete','pickup.draw','share.create','share.revoke','export.pdf','export.jpg','export.csv','profile.update','organization.save','export.personal','import.personal','import.review'] && d.summary is string && d.summary.size()>0 && d.summary.size()<=500 && d.details is string && d.details.size()<=24000 && d.dayId is string && d.dayId.size()<=100 && d.orderId is string && d.orderId.size()<=70 && d.reference is string && d.reference.size()<=23;}
  match /activityLogs/{id}{allow read: if customerAccount() && (admin() || resource.data.actorId==request.auth.uid);allow create: if customerAccount() && id.matches('^[A-Za-z0-9_-]{20,32}$') && validActivity(request.resource.data) && (request.resource.data.source=='app' ? !request.resource.data.kind.matches('^bank[.].*') : (paymentBot() && (request.resource.data.kind=='bank.notice' || (request.resource.data.kind=='bank.received' && getAfter(/databases/$(database)/documents/paymentReceipts/$(request.resource.data.reference)).data.createdBy==request.auth.uid && getAfter(/databases/$(database)/documents/paymentReceipts/$(request.resource.data.reference)).data.createdAt==request.time))));allow update,delete: if false;}

  function validLink(d,sourceUid){
   return d.keys().hasAll(['targetUid','createdAt','expiresAt']) && d.keys().hasOnly(['targetUid','createdAt','expiresAt'])
    && customerAccount() && sourceUid == request.auth.uid && request.auth.token.firebase.sign_in_provider == 'anonymous'
    && d.targetUid is string && d.targetUid.matches('^[A-Za-z0-9_-]{1,128}$') && d.targetUid != sourceUid
    && d.createdAt == request.time && d.expiresAt is timestamp && d.expiresAt > request.time && d.expiresAt <= request.time + duration.value(10,'m');
  }
  function validLegacyPayment(d){
   return d.keys().hasAll(['qrUrl','updatedAt']) && d.keys().hasOnly(['qrUrl','updatedAt']) && d.qrUrl is string && d.qrUrl.size()<=200000
    && (d.qrUrl == '' || (d.qrUrl.size()<=2000 && d.qrUrl.matches('https://[^ ]+')) || d.qrUrl.matches('data:image/(png|jpeg);base64,[A-Za-z0-9+/=]+')) && d.updatedAt == request.time;
  }
  function pickupDate(value){let parts=value.split('-');return timestamp.date(int(parts[0]),int(parts[1]),int(parts[2]));}
  function validPickupPerson(person,name,previous){
   return name is string && name.matches('^[^\r\n]{1,100}$')
    && person is string && person.matches('^[^\r\n]{1,100}$')
    && previous is int && previous>=0 && previous<=6;
  }
  function validPickupItem(keys,names,counts,count,i){return count<=i || validPickupPerson(keys[i],names[i],counts[i]);}
  function validPickupTime(d){
   let day=pickupDate(d.date);
   let week=pickupDate(d.weekStart);
   return (week.toMillis()-timestamp.date(1970,1,5).toMillis()) % 604800000 == 0
    && week<=day && day<week+duration.value(7,'d')
    && request.time >= day-duration.value(7,'h') && request.time < day+duration.value(17,'h');
  }
  function validPickup(d,date){
   let fields=d.keys();
   let keys=d.selectedKeys;
   let names=d.selectedNames;
   let counts=d.previousCounts;
   let count=d.count;
   return fields.size()==11 && fields.hasOnly(['date','weekStart','dayId','count','candidateCount','selectedNames','previousCounts','selectedKeys','createdBy','createdAt','version'])
    && date == d.date && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && d.weekStart is string && d.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && validPickupTime(d)
    && d.dayId is string && d.dayId.matches('^[A-Za-z0-9_-]{1,100}$')
    && count is int && count>=1 && count<=10 && d.candidateCount is int && d.candidateCount>=count && d.candidateCount<=500
    && names is list && names.size()==count && counts is list && counts.size()==count
    && keys is list && keys.size()==count && keys.toSet().size()==count
    && validPickupItem(keys,names,counts,count,0) && validPickupItem(keys,names,counts,count,1) && validPickupItem(keys,names,counts,count,2) && validPickupItem(keys,names,counts,count,3) && validPickupItem(keys,names,counts,count,4)
    && validPickupItem(keys,names,counts,count,5) && validPickupItem(keys,names,counts,count,6) && validPickupItem(keys,names,counts,count,7) && validPickupItem(keys,names,counts,count,8) && validPickupItem(keys,names,counts,count,9)
    && d.createdBy == request.auth.uid && d.createdAt == request.time && d.version is int && d.version == 1
    && exists(/databases/$(database)/documents/days/$(d.dayId)) && get(/databases/$(database)/documents/days/$(d.dayId)).data.date == d.date
    && get(/databases/$(database)/documents/days/$(d.dayId)).data.status == 'closed';
