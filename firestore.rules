    && get(/databases/$(database)/documents/admins/$(before.updatedBy)).data.enabled==true
    && after.deleted==true && after.blocked==true && after.deletionToken==before.deletionToken && after.deletedBy==before.updatedBy && after.deletedAt==request.time && after.updatedBy==request.auth.uid && after.updatedAt==request.time;
  }
  function validDeletedUserAccess(d,uid){return d.keys().hasAll(['blocked','deleted','deletedBy','deletedAt','deletionToken','updatedBy','updatedAt']) && d.keys().hasOnly(['blocked','deleted','deletedBy','deletedAt','deletionToken','updatedBy','updatedAt']) && validUid(d.deletedBy) && validUid(d.updatedBy) && d.deletionToken is string && d.deletionToken.matches('^[a-f0-9]{32}$') && userDeletionService(uid) && !existsAfter(/databases/$(database)/documents/userProfiles/$(uid)) && !existsAfter(/databases/$(database)/documents/personalDetails/$(uid));}
  match /userProfiles/{uid}{
