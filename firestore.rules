   match /cancelledOrders/{orderId}{allow read: if admin();allow create: if admin() && validChangeReceipt(request.resource.data,id,orderId);allow update,delete: if false;}
   match /pendingOrders/{orderId}{allow read: if admin();allow create: if admin() && request.resource.data.keys().hasAll(['ownerId','createdAt','createdBy']) && request.resource.data.keys().hasOnly(['ownerId','createdAt','createdBy']) && request.resource.data.createdBy==request.auth.uid && request.resource.data.createdAt==request.time && request.resource.data.ownerId==get(/databases/$(database)/documents/days/$(get(/databases/$(database)/documents/mealDayChanges/$(id)).data.dayId)/orders/$(orderId)).data.ownerId && get(/databases/$(database)/documents/days/$(get(/databases/$(database)/documents/mealDayChanges/$(id)).data.dayId)/orders/$(orderId)).data.cancelled==false && lockedDayChange(get(/databases/$(database)/documents/mealDayChanges/$(id)).data.dayId) && get(/databases/$(database)/documents/days/$(get(/databases/$(database)/documents/mealDayChanges/$(id)).data.dayId)).data.changeId==id;allow update,delete: if false;}
   match /fulfillmentArchive/{entry}{allow read: if admin();allow create: if admin() && entry=='previous' && lockedDayChange(get(/databases/$(database)/documents/mealDayChanges/$(id)).data.dayId) && get(/databases/$(database)/documents/days/$(get(/databases/$(database)/documents/mealDayChanges/$(id)).data.dayId)).data.changeId==id && request.resource.data==get(/databases/$(database)/documents/merchantFulfillments/$(get(/databases/$(database)/documents/mealDayChanges/$(id)).data.dayId)).data && !existsAfter(/databases/$(database)/documents/merchantFulfillments/$(get(/databases/$(database)/documents/mealDayChanges/$(id)).data.dayId));allow update,delete: if false;}
  }

  match /days/{dayId}{
   allow read: if customerAccount() || merchantDayAccess(dayId);
   allow create: if (admin() || (merchantEditor(dayId) && dayId=='day-'+request.resource.data.date && request.resource.data.status=='auto')) && dayId.matches('^[A-Za-z0-9_-]{1,100}$') && validDay(request.resource.data) && newClosure(request.resource.data) && !('changeId' in request.resource.data);
   allow update: if validDay(request.resource.data) && request.resource.data.date==resource.data.date && ((admin() && (resource.data.get('changing',false)==true || request.resource.data.get('changing',false)==true) && (startingDayChange(dayId,resource.data,request.resource.data) || finishingDayChange(dayId,resource.data,request.resource.data))) || (resource.data.get('changing',false)==false && changeFieldsSame(resource.data,request.resource.data) && closureChange(resource.data,request.resource.data) && (admin() || (merchantEditor(dayId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label','menuCount','updatedAt'])))));
   allow delete: if false;
   match /dishes/{dishId}{
    allow read: if (customerAccount() || merchantDayAccess(dayId)) && parentExists(dayId);
    allow create,update: if (admin() || merchantEditor(dayId)) && getAfter(/databases/$(database)/documents/days/$(dayId)).data.date is string && validDish(request.resource.data,dishId);
    allow delete: if false;
   }
   match /orders/{orderId}{
    // All app visitors receive an anonymous Firebase session and may view meals.
    // Editing, cancellation, payment and ownership transfer remain checked below.
    allow get,list: if (customerAccount() || (releasedDay(dayId) && merchantDayAccess(dayId))) && parentExists(dayId);
    allow create: if customerAccount() && activeUser() && accountWritable(request.resource.data.ownerId) && validOrder(request.resource.data,orderId) && (request.resource.data.ownerId == request.auth.uid || admin())
     && request.resource.data.createdAt == request.time && request.resource.data.paid == false && request.resource.data.cancelled == false && received(request.resource.data)==0 && refunded(request.resource.data)==0 && voided(request.resource.data)==0 && creditIn(request.resource.data)==0 && creditOut(request.resource.data)==0 && choice(request.resource.data)=='refund' && request.resource.data.get('lastCreditTransferId','')=='' && request.resource.data.get('paymentEventId','')=='' && personOrderAccess(dayId,orderId,request.resource.data) && openDay(dayId) && menuPrice(dayId,request.resource.data);
    allow update: if customerAccount() && parentExists(dayId) && validOrder(request.resource.data,orderId) && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.name == resource.data.name && (
     (paymentBot() && (get(/databases/$(database)/documents/paymentLinks/$(dayId)/orders/$(orderId)).data.get('kind','single')=='group'?webhookGroupPayment(dayId,orderId,request.resource.data):webhookPayment(dayId,orderId,request.resource.data)))
     || (request.resource.data.ownerId != resource.data.ownerId && accountWritable(resource.data.ownerId) && accountWritable(request.resource.data.ownerId) && request.resource.data.ownerId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId','updatedAt']) && recipient(resource.data.ownerId) && editableLinkedOrder(dayId,orderId) && creditPointerMove(dayId,orderId))
     || (editableLinkedOrder(dayId,orderId) && request.resource.data.ownerId == resource.data.ownerId && (
      (choice(request.resource.data)!=choice(resource.data) && (ownOrder() || admin()) && surplusChange(dayId,orderId,request.resource.data))
      || (request.resource.data.get('lastCreditTransferId','')!=resource.data.get('lastCreditTransferId','') && linkedCreditTransfer(dayId,orderId,request.resource.data))
      || (admin() && request.resource.data.get('paymentEventId','')!=resource.data.get('paymentEventId','') && financialEvent(dayId,orderId,request.resource.data))
      || (get(/databases/$(database)/documents/days/$(dayId)).data.get('changing',false)==true ? validDayJobCancellation(request.resource.data,dayId,orderId) : (((ownOrder() && (activeUser() || (request.resource.data.cancelled==true && request.resource.data.paid==false && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelled','paid','receivedAmount','refundedAmount','voidedAmount','creditInAmount','creditOutAmount','surplusChoice','updatedAt'])))) || admin()) && openDay(dayId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dishId','dish','price','quantity','note','paid','cancelled','receivedAmount','refundedAmount','voidedAmount','creditInAmount','creditOutAmount','surplusChoice','updatedAt'])
       && (samePrice(request.resource.data) || menuPrice(dayId,request.resource.data)) && correctPayment(request.resource.data))
     )))
    );
    allow delete: if false;
   }
  }
  // Explicitly public capability link requested for restaurant handoff. No list
  // access without admin, no user/payment fields in the validated JSON view.
  function validRestaurantShare(d,token){return token.matches('^[a-f0-9]{32}$') && d.keys().hasAll(['dayId','payload','active','version','createdBy','createdAt','expiresAt']) && d.keys().hasOnly(['dayId','payload','active','version','createdBy','createdAt','expiresAt']) && d.dayId is string && d.dayId.matches('^[A-Za-z0-9_-]{1,100}$') && parentExists(d.dayId) && d.payload is string && d.payload.size()>0 && d.payload.size()<=300000 && d.active is bool && d.version==1 && validUid(d.createdBy) && d.createdAt is timestamp && d.expiresAt is timestamp && d.expiresAt>d.createdAt && d.expiresAt<=d.createdAt+duration.value(7,'d');}
  match /restaurantShares/{token}{
   allow get: if admin() || (resource.data.active==true && request.time<resource.data.expiresAt);allow list: if admin();
   allow create: if admin() && validRestaurantShare(request.resource.data,token) && request.resource.data.createdBy==request.auth.uid && request.resource.data.createdAt==request.time && request.resource.data.active==true;
   allow update: if admin() && validRestaurantShare(request.resource.data,token) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']) && request.resource.data.active==false;
   allow delete: if false;
  }
  match /{path=**}{allow read,write: if false;}
 }
}
